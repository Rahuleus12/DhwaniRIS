# Copy this file to .env and set real values before starting the stack:
#   cp .env.example .env
#
# .env is gitignored. Secrets must never enter the repository or its history.

# Password for the MariaDB root account. Local only — the app never uses it.
DB_ROOT_PASSWORD=set-a-real-password-here

# Application database, and the least-privilege account the app uses.
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=set-a-different-real-password-here
